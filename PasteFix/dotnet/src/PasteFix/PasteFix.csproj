<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Without this the exe carries no version at all, so a downloaded binary
         cannot be told apart from any other. Keep it in step with the git tag. -->
    <Version>1.0.0</Version>
    <Product>Pastefix</Product>
    <Description>Makes a multi-line command copied from a chat window pasteable into a terminal in one go.</Description>
    <Copyright>Copyright (c) 2026 Ch1nYu</Copyright>
  </PropertyGroup>

  <!-- ApplicationIcon only sets the icon Explorer shows on the exe. NotifyIcon
       needs the file itself at run time, and PublishSingleFile leaves nothing
       beside the exe to read — so it is embedded and loaded from the stream.
       Regenerate with tools/make-icon.ps1. -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="PasteFix.app.ico" />
  </ItemGroup>

</Project>